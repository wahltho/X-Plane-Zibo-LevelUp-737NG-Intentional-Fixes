        "-- FIX: APP REF ILS/LDA lookup hardening.",
        "-- Match runway tokens more robustly so APP REF can still resolve freq/course",
        "-- when navdata and CIFP use an alpha suffix variant such as RW08T.",
        "function B738_match_app_ref_runway(runway_a, runway_b)",
        "\tif B738DR_fms_nav_match_runway_in_a ~= nil",
        "\t\tand B738DR_fms_nav_match_runway_in_b ~= nil",
        "\t\tand B738DR_fms_nav_match_runway_value ~= nil then",
        "\t\tB738DR_fms_nav_match_runway_in_a = runway_a or \"\"",
        "\t\tB738DR_fms_nav_match_runway_in_b = runway_b or \"\"",
        "\t\treturn B738DR_fms_nav_match_runway_value ~= 0",
        "\tend",
        "",
        "\tlocal function norm_runway_token(runway_in)",
        "\t\tif runway_in == nil then",
        "\t\t\treturn \"\", \"\", \"\"",
        "\t\tend",
        "\t\tlocal runway = string.upper(runway_in)",
        "\t\tif string.sub(runway, 1, 2) == \"RW\" then",
        "\t\t\trunway = string.sub(runway, 3, -1)",
        "\t\tend",
        "\t\tlocal num_txt = string.match(runway, \"^(%d%d?)\")",
        "\t\tif num_txt == nil then",
        "\t\t\treturn runway, \"\", \"\"",
        "\t\tend",
        "\t\tlocal num = tonumber(num_txt)",
        "\t\tif num == nil then",
        "\t\t\treturn runway, \"\", \"\"",
        "\t\tend",
        "\t\tlocal suffix = string.sub(runway, string.len(num_txt) + 1, -1)",
        "\t\treturn string.format(\"%02d\", num) .. suffix, string.format(\"%02d\", num), suffix",
        "\tend",
        "",
        "\tlocal norm_a, num_a, suffix_a = norm_runway_token(runway_a)",
        "\tlocal norm_b, num_b, suffix_b = norm_runway_token(runway_b)",
        "\tif norm_a == \"\" or norm_b == \"\" then",
        "\t\treturn false",
        "\tend",
        "\tif norm_a == norm_b then",
        "\t\treturn true",
        "\tend",
        "\tif num_a ~= \"\" and num_a == num_b then",
        "\t\tif suffix_a == \"\" and suffix_b ~= \"\" then",
        "\t\t\treturn suffix_b ~= \"L\" and suffix_b ~= \"R\" and suffix_b ~= \"C\"",
        "\t\telseif suffix_b == \"\" and suffix_a ~= \"\" then",
        "\t\t\treturn suffix_a ~= \"L\" and suffix_a ~= \"R\" and suffix_a ~= \"C\"",
        "\t\tend",
        "\tend",
        "\treturn false",
        "end",
