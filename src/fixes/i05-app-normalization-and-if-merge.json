        "",
        "-- FIX: ARRIVALS page display normalization for approach IDs.",
        "-- If selected APP has a Y/Z suffix variant (e.g. I30-Y, I30Y) that is not present",
        "-- in current APP list, but the base ID exists (e.g. I30), display the base ID.",
        "function B738_arrivals_display_app_id(app_id)",
        "\tif app_id == nil or app_id == \"\" then",
        "\t\treturn app_id",
        "\tend",
        "\tif app_list_num == nil or app_list_num < 1 then",
        "\t\treturn app_id",
        "\tend",
        "",
        "\tfor i = 1, app_list_num do",
        "\t\tif app_list[i] ~= nil and app_list[i][1] == app_id then",
        "\t\t\treturn app_id",
        "\t\tend",
        "\tend",
        "",
        "\tlocal base_id = \"\"",
        "\tlocal id_len = string.len(app_id)",
        "\tlocal last_ch = string.sub(app_id, -1, -1)",
        "\tif id_len >= 3 and (last_ch == \"Y\" or last_ch == \"Z\") then",
        "\t\tlocal dash_pos = string.find(app_id, \"%-[YZ]$\")",
        "\t\tif dash_pos ~= nil then",
        "\t\t\tbase_id = string.sub(app_id, 1, dash_pos - 1)",
        "\t\telse",
        "\t\t\tbase_id = string.sub(app_id, 1, -2)",
        "\t\tend",
        "\tend",
        "",
        "\tif base_id ~= \"\" then",
        "\t\tfor i = 1, app_list_num do",
        "\t\t\tif app_list[i] ~= nil and app_list[i][1] == base_id then",
        "\t\t\t\treturn base_id",
        "\t\t\tend",
        "\t\tend",
        "\tend",
        "",
        "\treturn app_id",
        "end",
        "",
        "function B738_fmc_arr99(in_mode)",
        "\t"
      ]
    },
