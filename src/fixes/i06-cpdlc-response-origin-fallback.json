    {
      "name": "I06 effective CPDLC response helper",
      "oldLines": [
        "function dl_cpdlc_message(in_msg)",
        "\tmax_page_buf = 1"
      ],
      "newLines": [
        "-- FIX: infer WILCO only for existing PDC/CLD messages whose response code is absent.",
        "function cpdlc_effective_rsp(in_msg)",
        "\tlocal rsp = atc_msg_rsp[in_msg]",
        "\tif rsp == nil then rsp = 0 end",
        "\tif rsp ~= 0 then return rsp end",
        "\tlocal txt = atc_msg_txt[in_msg]",
        "\tif txt == nil or txt == \"\" then return rsp end",
        "\tlocal up = string.upper(txt)",
        "\tlocal is_pdc = string.find(up, \" PDC \", 1, true) ~= nil or string.find(up, \" PREDEP CLEARANCE\", 1, true) ~= nil",
        "\tlocal is_cld = string.sub(up, 1, 4) == \"CLD \"",
        "\tif is_pdc or is_cld then return 2 end",
        "\treturn rsp",
        "end",
        "",
        "function dl_cpdlc_message(in_msg)",
        "\tmax_page_buf = 1"
      ]
    },
