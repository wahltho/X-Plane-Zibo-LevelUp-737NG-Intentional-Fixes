      "newLines": [
        "-- FIX: arm an active manual hold intercept without rewriting the new HA/HF/HM row to DF.",
        "function B738_arm_manual_hold_intercept(in_item, in_rte, on_ground)",
        "\tif rte12_act ~= in_rte then return end",
        "\tlocal nd_lat2 = 0",
        "\tlocal nd_lon2 = 0",
        "\tif in_rte == 0 then nd_lat2, nd_lon2 = lat_lon_legs2(in_item) else nd_lat2, nd_lon2 = lat_lon_legs8(in_item) end",
        "\tif on_ground == false then",
        "\t\tlegs_intdir = 1",
        "\t\tlegs_intdir_rte = in_rte",
        "\t\tlegs_intdir_idx_mod = in_item",
        "\t\tlocal nd_lat = math.rad(simDR_latitude)",
        "\t\tlocal nd_lon = math.rad(simDR_longitude)",
        "\t\tnd_lat2 = math.rad(nd_lat2)",
        "\t\tnd_lon2 = math.rad(nd_lon2)",
        "\t\tlocal nd_y = math.sin(nd_lon2 - nd_lon) * math.cos(nd_lat2)",
        "\t\tlocal nd_x = math.cos(nd_lat) * math.sin(nd_lat2) - math.sin(nd_lat) * math.cos(nd_lat2) * math.cos(nd_lon2 - nd_lon)",
        "\t\tlocal nd_hdg = (math.deg(math.atan2(nd_y, nd_x)) + 360) % 360",
        "\t\tlegs_intdir_crs_mod = (nd_hdg + simDR_mag_variation + 360) % 360",
        "\tend",
        "end",
        "",
        "function rte_add_wpt(aaa, entry_in, mode_in, in_rte)"
      ]
    },
