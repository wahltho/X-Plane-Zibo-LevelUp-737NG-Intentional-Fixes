      "newLines": [
        "-- FIX: preserve manual/procedure hold identity when stock route mutations temporarily",
        "-- rewrite a same-fix hold row to DF.",
        "function B738_is_hold_context_leg(legs_tbl, leg_idx, in_rte)",
        "\tif legs_tbl == nil or leg_idx == nil or leg_idx < 1 then return false end",
        "\tlocal leg = legs_tbl[leg_idx]",
        "\tif leg == nil then return false end",
        "\tlocal path_txt = tostring(leg[31] or \"\")",
        "\tif path_txt == \"HA\" or path_txt == \"HF\" or path_txt == \"HM\" then return true end",
        "\tif path_txt ~= \"DF\" then return false end",
        "\tlocal leg_id = tostring(leg[1] or \"\")",
        "\tlocal prev_leg = legs_tbl[leg_idx - 1]",
        "\tif leg_id == \"\" or prev_leg == nil then return false end",
        "\tif tostring(prev_leg[1] or \"\") ~= leg_id then return false end",
        "\tif tostring(prev_leg[16] or \"\") ~= tostring(leg[16] or \"\") then return false end",
        "\tlocal prev_path = tostring(prev_leg[31] or \"\")",
        "\tif prev_path == \"HA\" or prev_path == \"HF\" or prev_path == \"HM\" then return false end",
        "\tlocal hold_td = tostring(leg[30] or \"\")",
        "\tlocal hold_turn = tonumber(leg[21]) or -1",
        "\tif hold_td == \"\" and hold_turn ~= 0 and hold_turn ~= 1 then return false end",
        "\tlocal leg_lat = tonumber(leg[7]) or 0",
        "\tlocal leg_lon = tonumber(leg[8]) or 0",
        "\tlocal prev_lat = tonumber(prev_leg[7]) or 0",
        "\tlocal prev_lon = tonumber(prev_leg[8]) or 0",
        "\tif math.abs(leg_lat - prev_lat) > 0.00001 or math.abs(leg_lon - prev_lon) > 0.00001 then return false end",
        "\tif in_rte == rte12_act then",
        "\t\tlocal active_idx = tonumber(offset_seq) or 0",
        "\t\tlocal offset_idx = tonumber(offset) or 0",
        "\t\tif leg_idx == active_idx or leg_idx == offset_idx then return true end",
        "\tend",
        "\tlocal prev_prev_leg = legs_tbl[leg_idx - 2]",
        "\tlocal prev_prev_path = prev_prev_leg ~= nil and tostring(prev_prev_leg[31] or \"\") or \"\"",
        "\treturn prev_prev_path == \"AF\" or prev_prev_path == \"RF\" or prev_prev_path == \"CI\" or prev_prev_path == \"VI\"",
        "end",
        "",
        "function B738_rebuild_hold_data_from_legs(legs_tbl, legs_cnt, in_rte)",
        "\tlocal hold_tbl = {}",
        "\tlocal hold_num = 0",
        "\tfor ii = 1, legs_cnt do",
        "\t\tif B738_is_hold_context_leg(legs_tbl, ii, in_rte) then",
        "\t\t\thold_num = hold_num + 1",
        "\t\t\thold_tbl[hold_num] = ii",
        "\t\tend",
        "\tend",
        "\treturn hold_tbl, hold_num",
        "end",
        "",
        "function B738_should_preserve_hold_offset_sync(legs_tbl, offset_mod_idx, in_rte)",
        "\tif legs_tbl == nil or offset_mod_idx == nil or offset_mod_idx < 1 then return false end",
        "\tif B738_is_hold_context_leg(legs_tbl, offset_mod_idx, in_rte) then return true end",
        "\tlocal next_idx = offset_mod_idx + 1",
        "\tif B738_is_hold_context_leg(legs_tbl, next_idx, in_rte) then return true end",
        "\tlocal next_leg = legs_tbl[next_idx]",
        "\tif next_leg == nil or (tonumber(next_leg[25]) or 0) ~= 0 then return false end",
        "\tlocal scan_idx = next_idx + 1",
        "\twhile legs_tbl[scan_idx] ~= nil do",
        "\t\tif B738_is_hold_context_leg(legs_tbl, scan_idx, in_rte) then return true end",
        "\t\tif (tonumber(legs_tbl[scan_idx][25]) or 0) ~= 0 then break end",
        "\t\tscan_idx = scan_idx + 1",
        "\tend",
        "\treturn false",
        "end",
        "",
        "function create_fpln(in_rte)",
        "",
        "\tlocal ii = 0"
      ]
