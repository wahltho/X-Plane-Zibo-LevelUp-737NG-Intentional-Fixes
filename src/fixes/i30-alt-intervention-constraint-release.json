        "-- FIX: ALT INTV releases exactly the next committed altitude constraint that",
        "-- conflicts with the selected MCP altitude. MOD ownership is preserved.",
        "local function B738_alt_intv_release_next_constraint(climb_mode)",
        "\tlocal end_idx = legs_num",
        "\tif climb_mode then",
        "\t\tend_idx = tc_idx - 1",
        "\telseif ed_found ~= 0 then",
        "\t\tend_idx = first_app_idx ~= 0 and (first_app_idx - 1) or (ed_found - 1)",
        "\tend",
        "\tif end_idx < offset then return false end",
        "\tfor nn = 1, legs_restr_alt_n do",
        "\t\tlocal n = legs_restr_alt[nn][2]",
        "\t\tif n > end_idx then break end",
        "\t\tif n >= offset and n <= legs_num then",
        "\t\t\tlocal rest_type = legs_restr_alt[nn][4]",
        "\t\t\tlocal alt1 = legs_restr_alt[nn][3]",
        "\t\t\tlocal alt2 = legs_restr_alt[nn][5]",
        "\t\t\tlocal release = false",
        "\t\t\tif climb_mode then",
        "\t\t\t\trelease = (rest_type == 41 and alt2 < B738DR_mcp_alt_dial) or alt1 < B738DR_mcp_alt_dial",
        "\t\t\telse",
        "\t\t\t\trelease = (rest_type == 41 and (alt1 > B738DR_mcp_alt_dial or alt2 > B738DR_mcp_alt_dial)) or alt1 > B738DR_mcp_alt_dial",
        "\t\t\tend",
        "\t\t\tif release then",
        "\t\t\t\tlocal old5 = legs_data[n][5]",
        "\t\t\t\tlocal old6 = legs_data[n][6]",
        "\t\t\t\tlocal old41 = legs_data[n][41]",
        "\t\t\t\tlegs_data[n][5] = 0",
        "\t\t\t\tlegs_data[n][6] = 0",
        "\t\t\t\tlegs_data[n][41] = 0",
        "\t\t\t\tif n <= legs_num2 and (legs_delete == 0 or (legs_data2[n][5] == old5 and legs_data2[n][6] == old6 and legs_data2[n][41] == old41)) then",
        "\t\t\t\t\tlegs_data2[n][5] = 0",
        "\t\t\t\t\tlegs_data2[n][6] = 0",
        "\t\t\t\t\tlegs_data2[n][41] = 0",
        "\t\t\t\tend",
        "\t\t\t\tfms_recalc = 1",
        "\t\t\t\tvnav_update = 1",
        "\t\t\t\tmsg_unavaible_crz_alt = 0",
        "\t\t\t\treturn true",
        "\t\t\tend",
        "\t\tend",
        "\tend",
        "\treturn false",
        "end",
